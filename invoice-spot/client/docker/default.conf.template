# The built client, with /api/ and /uploads/ passed on to the backend: the
# browser sees one origin, so there is no CORS and the refresh cookie can be
# SameSite=Lax. The image fills in BACKEND_ORIGIN when the container starts.

# The port the browser used, when its Host header names one. Without it the
# backend takes 80 or 443 from X-Forwarded-Proto.
map $http_host $forwarded_port {
    ~:(\d+)$ $1;
    default  "";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Above the backend's own 2 MB upload limit, so its message comes back
    # rather than nginx's.
    client_max_body_size 5m;

    # The backend's address is looked up again through Docker's own DNS every
    # few seconds, so a backend restarted on a new address is still reached.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # The backend sets its own headers on these. Passed through a variable,
    # nginx resolves the address per request and keeps the request's path.
    location ~ ^/(api|uploads)/ {
        set $backend ${BACKEND_ORIGIN};
        proxy_pass $backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $forwarded_port;
    }

    # Vite names these by their content, so one never changes. A missing one
    # is a 404, not the app's page.
    location /assets/ {
        try_files $uri =404;
        include security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Every other path is a page of the app. index.html is checked on every
    # visit, so a new release shows at once.
    location / {
        try_files $uri /index.html;
        include security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
}
