# Settings for docker compose. Copy this file to .env, which git ignores, and
# replace every change-me; the app refuses to start with the placeholder keys.
# Every line reaches the backend as an environment variable.

# --- Database ---------------------------------------------------------------
# The db service creates the database with these, and the backend signs in
# with them. The database is reachable only inside the stack.
POSTGRES_DB=invoicespot
POSTGRES_USER=invoicespot
POSTGRES_PASSWORD=change-me

# --- Secrets ----------------------------------------------------------------
# Signs sign-in tokens; at least 32 bytes. Make one with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET_KEY=change-me
# Seals two-factor secrets and stored share and portal links: 32 random
# bytes, base64. Keep it: a new key can't read what the old one sealed.
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=change-me

# --- Addresses --------------------------------------------------------------
# Where people open the app. nginx serves the client and the API from the
# same origin, so both are the same; CLIENT_URL goes into share, portal and
# password-reset links, SERVER_URL into email verification links.
CLIENT_URL=http://localhost:8088
SERVER_URL=http://localhost:8088
# The host ports this stack publishes; keep the URLs above on WEB_PORT.
WEB_PORT=8088
MAILPIT_UI_PORT=8027

# --- Sign-in cookie ---------------------------------------------------------
# The refresh cookie. Set COOKIE_SECURE=true once the app is served over
# HTTPS. The API is on the app's own origin, so Lax is enough. A client served
# from another site than the API (built with VITE_API_URL) needs None instead,
# which browsers accept only on a Secure cookie over HTTPS.
COOKIE_SECURE=false
APP_COOKIE_SAMESITE=Lax

# --- Email ------------------------------------------------------------------
# The address emails come from.
SENDER_EMAIL=invoices@example.com
# mailpit:1025 is the Mailpit started by `--profile mail`; read what was sent
# at http://localhost:8027. For real email, use your SMTP server instead.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
# For an SMTP server that needs a login (Spring reads these directly):
# SPRING_MAIL_USERNAME=change-me
# SPRING_MAIL_PASSWORD=change-me
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Google sign-in (optional) ----------------------------------------------
# The Google button shows once both are set. In the Google Cloud console,
# register this authorised redirect URI (CLIENT_URL followed by the path):
#   http://localhost:8088/api/v1/auth/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Running several backends -----------------------------------------------
# Rate limits are kept in PostgreSQL so every backend counts the same
# attempts. false keeps them in each backend's memory.
RATE_LIMIT_SHARED=true

# --- Monitoring -------------------------------------------------------------
# The actuator (health, and Prometheus metrics at /actuator/prometheus)
# listens on this port. It isn't published, so only containers in the stack
# can reach it, e.g.
#   docker compose exec backend curl -s localhost:8081/actuator/prometheus
MANAGEMENT_PORT=8081
